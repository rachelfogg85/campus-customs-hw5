# Copy this file to `.env` in this same folder (hw5/) and fill in a real key.
# Never commit a file that contains a real key -- only this .env.example
# (placeholders only) should ever be checked in or shared.

# Required: your Portkey API key. Every AI call in this project is routed
# through Portkey rather than calling OpenAI directly. Every agent uses
# gpt-6-luna (hardcoded in backend/agents/config.py) -- there is nothing to
# set here for the model name or base URL.
PORTKEY_API_KEY=your-portkey-api-key-here
